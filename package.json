{
  "name": "liara-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI DevOps/SRE co-worker for Liara: deploy, monitor, diagnose, fix and verify — as a web chat and an MCP server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe-liara.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "accept:prd01": "AUTO_APPROVE=true tsx scripts/acceptance/prd01.ts",
    "accept:prd02": "AUTO_APPROVE=true tsx scripts/acceptance/prd02.ts",
    "accept:prd03": "tsx scripts/acceptance/prd03.ts",
    "dev:sim": "LIARA_FAKE=1 next dev -p 3210",
    "chaos": "tsx scripts/chaos.ts",
    "shots": "tsx scripts/shots.ts",
    "deploy:self": "tsx scripts/deploy-self.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.148",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "ignore": "^7.0.13",
    "next": "^15.5.28",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.22",
    "undici": "^7.30.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "pino-pretty": "^13.2.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vazirmatn": "^33.0.3",
    "vitest": "^5.0.5"
  }
}
